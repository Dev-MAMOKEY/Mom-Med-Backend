# PostgreSQL 컨테이너 초기화에 사용할 로컬 개발용 DB 이름입니다.
POSTGRES_DB=mom_med

# PostgreSQL 컨테이너 초기화에 사용할 로컬 개발용 DB 계정입니다.
POSTGRES_USER=mom_med

# 실제 비밀번호는 .env에만 작성하세요. 이 값은 예시입니다.
POSTGRES_PASSWORD=change-me-in-local-env

# 호스트에서 PostgreSQL 컨테이너에 접근할 포트입니다. 로컬 5432가 이미 사용 중이면 .env에서 15432 등으로 바꾸세요.
POSTGRES_PORT=5432

# Spring Boot datasource가 사용할 JDBC URL입니다.
DATABASE_URL=jdbc:postgresql://localhost:5432/mom_med

# Redis 연결 URL입니다. Slice 04/07에서 rate limit과 lock 용도로 사용합니다.
REDIS_URL=redis://localhost:6379

# 식약처 API 인증키입니다. 실제 키는 .env에만 작성하세요.
MFDS_API_KEY=

# HIRA API 인증키입니다. 실제 키는 .env에만 작성하세요.
HIRA_API_KEY=

# 기상청 API 인증키입니다. 실제 키는 .env에만 작성하세요.
KMA_API_KEY=

# Gemini API 인증키입니다. 실제 키는 .env에만 작성하세요.
GEMINI_API_KEY=

# pgcrypto 컬럼 암호화용 애플리케이션 마스터키입니다. 실제 값은 .env에만 작성하세요.
APP_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key
