# Docker Compose가 PostgreSQL 컨테이너 내부에 생성할 DB 이름입니다.
POSTGRES_DB=mom_med

# Docker Compose와 Spring Boot가 함께 사용할 DB 계정입니다.
POSTGRES_USER=postgres

# Docker Compose와 Spring Boot가 함께 사용할 DB 비밀번호입니다.
# 실제 비밀번호는 .env에만 적고 Git에는 올리지 않습니다.
POSTGRES_PASSWORD=change-me-in-local-env

# Docker Compose PostgreSQL 컨테이너의 호스트 포트입니다.
# 로컬 5432가 이미 사용 중이면 .env에서 15432 등으로 변경하세요.
POSTGRES_PORT=15432

# Spring Boot가 PostgreSQL에 접속할 때 사용하는 JDBC URL입니다.
# POSTGRES_PORT와 POSTGRES_DB를 바꿨다면 이 값도 같은 포트/DB 이름으로 맞춰야 합니다.
DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/mom_med

# Redis 연결 URL입니다. Slice 04/07에서 rate limit과 분산 락에 사용합니다.
REDIS_URL=redis://localhost:6379

# 식약처 API 인증키입니다. 실제 키는 .env에만 작성하세요.
MFDS_API_KEY=

# HIRA API 인증키입니다. 실제 키는 .env에만 작성하세요.
HIRA_API_KEY=

# 기상청 API 인증키입니다. 실제 키는 .env에만 작성하세요.
KMA_API_KEY=

# Gemini API 인증키입니다. 실제 키는 .env에만 작성하세요.
GEMINI_API_KEY=

# pgcrypto 컬럼 암호화에 사용할 애플리케이션 마스터키입니다. 실제 값은 .env에만 작성하세요.
APP_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key
