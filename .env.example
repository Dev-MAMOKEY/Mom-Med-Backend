# =============================================================================
# Docker Compose + Spring Boot 컨테이너가 공유하는 환경 변수 템플릿입니다.
# 실제 값은 .env에 작성하고 절대 Git에 올리지 마세요.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL — Docker 컨테이너 (mamoki-postgres) 설정
# -----------------------------------------------------------------------------
# 컨테이너 내부 DB 이름
POSTGRES_DB=mom_med

# DB 계정 (Spring Boot도 같은 값 사용)
POSTGRES_USER=postgres

# DB 비밀번호 — 반드시 설정! 비어있으면 compose 시작 실패합니다.
POSTGRES_PASSWORD=change-me-in-local-env

# 호스트 → 컨테이너 포트 매핑.
# 호스트에 이미 다른 PostgreSQL이 5432에 떠 있으면 충돌 회피용으로 15432 사용.
POSTGRES_PORT=15432

# -----------------------------------------------------------------------------
# RDS — B 방식(docker-compose.rds.yml) 전용. AWS RDS PostgreSQL에 접속.
# 로컬용 docker-compose.yml을 쓸 때는 무시됩니다.
# -----------------------------------------------------------------------------
# AWS 콘솔 > RDS > 해당 DB > "엔드포인트 및 포트"에서 복사.
# 형식: jdbc:postgresql://<엔드포인트>:5432/<DB이름>
# RDS_DB_URL=jdbc:postgresql://my-db.xxxxx.ap-northeast-2.rds.amazonaws.com:5432/mom_med
RDS_DB_URL=
# RDS 마스터 계정(또는 스키마 생성 권한이 있는 계정)
RDS_DB_USER=postgres
RDS_DB_PASSWORD=

# 다른 사람이 pull 할 이미지 경로 (본인 Docker Hub 아이디로).
BACKEND_IMAGE=kdh9695/mom-med-backend:0.0.1

# -----------------------------------------------------------------------------
# Redis — Docker 컨테이너 (mamoki-redis) 설정
# -----------------------------------------------------------------------------
# 호스트 → 컨테이너 포트 매핑. 호스트 6379와 충돌 회피용 기본 16379.
REDIS_PORT=16379

# -----------------------------------------------------------------------------
# Backend — Spring Boot 컨테이너 (mamoki-backend) 설정
# -----------------------------------------------------------------------------
# 호스트의 API 노출 포트. 프론트엔드 .env의 EXPO_PUBLIC_API_BASE_URL과 맞춰야 합니다.
BACKEND_PORT=8080

# Spring Boot 프로파일 (compose가 자동 설정하지만 override 가능)
# SPRING_PROFILES_ACTIVE=docker

# -----------------------------------------------------------------------------
# 외부 API 키 — .env에 실제 값을 적으세요.
# -----------------------------------------------------------------------------
# 식약처 API 인증키
MFDS_API_KEY=

# HIRA API 인증키 (KCD 코드 검증)
HIRA_API_KEY=

# 기상청 API 인증키 (Slice 06~07)
KMA_API_KEY=

# Gemini LLM 인증키
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 보안
# -----------------------------------------------------------------------------
# pgcrypto 컬럼 암호화 마스터키 — 32바이트 base64 권장.
# 반드시 설정! 비어있으면 backend 컨테이너 시작 실패합니다.
APP_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key

# -----------------------------------------------------------------------------
# DUR CSV ETL (선택)
# -----------------------------------------------------------------------------
# DUR 의약품 안전사용 서비스 CSV 5개가 들어있는 호스트 디렉토리.
# 컨테이너에 read-only로 /data/dur에 마운트됩니다.
# 비워두면 ETL이 자동 skip (이미 DB에 적재된 데이터가 있다면 영향 없음).
# DUR_DATA_DIR=C:/Users/tiilk/Desktop/test2/data/...

# DUR ETL을 컨테이너 시작 시 실행할지 (idempotent, ON CONFLICT DO NOTHING).
# 첫 빌드 시 한 번 true로, 이후엔 false로 두면 시작 시간 단축.
APP_ETL_DUR_ENABLED=false

# -----------------------------------------------------------------------------
# JVM (선택 override)
# -----------------------------------------------------------------------------
# Dockerfile에 IPv4 stack 기본 설정. 다른 옵션 추가 시 여기에:
# JAVA_TOOL_OPTIONS=-Djava.net.preferIPv4Stack=true -Xmx512m
