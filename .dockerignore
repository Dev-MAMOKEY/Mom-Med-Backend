build/
.gradle/
*.log
spring.log

# IDE
.idea/
.vscode/
*.iml

# Git
.git/
.gitignore
.gitattributes

# 도커 자체
Dockerfile
.dockerignore
docker-compose.yml

# 환경 변수 파일은 빌드 시점이 아니라 런타임에 주입 (compose env_file)
.env
.env.local
*.env

# Windows 전용 스크립트
start-with-etl.ps1

